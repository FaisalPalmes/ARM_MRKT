# secrets — never committed
.env
.env.*
!.env.example

# generated — rebuilt from the data, never hand-edited
hub/dist/
feed/dist/

# raw media never goes in git — index it, don't commit it
assets/files/*
!assets/files/.gitkeep
*.jpg
*.jpeg
*.png
*.mp4
*.mov
*.heic
*.log

node_modules/
.vercel/
.DS_Store
__pycache__/
*.pyc
