# Copy to .env and fill in. .env is gitignored. No key or token ever goes anywhere else.

# feed/publish.sh — local clone of the owner portal repo (FaisalPalmes/ARMAN_OWNER_PORTAL)
PORTAL_REPO_PATH=
# path inside that repo where content.json is expected, per feed/PORTAL_FEED_CONTRACT.md
PORTAL_FEED_PATH=

# assets — where the shoot originals live (Drive folder or local path). The index refers to filenames only.
ASSET_STORE_PATH=
